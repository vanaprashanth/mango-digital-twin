# Mango Digital Twin data-refresh pipeline for GCP Cloud Run Jobs.
# Runs the Python pipeline (NOT the Streamlit server) and exits non-zero on failure.
#
#   docker build -f Dockerfile.pipeline -t mangotwin-pipeline .
#
# Data is NOT baked into the image: required inputs are downloaded from
# gs://mango-digital-twin-vsp-data/data/ at start-up and outputs uploaded back
# (see src/cloud/run_pipeline_job.py). Authentication is Application Default
# Credentials, i.e. the job's service account; no key files are copied in.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MANGOTWIN_GCS_BUCKET=mango-digital-twin-vsp-data \
    MANGOTWIN_GCS_PREFIX=data

WORKDIR /app

# Pinned (Python 3.12) set; the Streamlit requirements.txt is intentionally not used here.
COPY requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt

# Copy only what the pipeline imports/reads - not app/, tests/, models/, data/.
COPY main.py ./
COPY configs ./configs
COPY src ./src

# Empty data tree + logs; run as an unprivileged user that can write to them.
RUN mkdir -p data/raw data/processed data/manual logs \
    && useradd --system --uid 10001 mangotwin \
    && chown -R mangotwin /app
USER mangotwin

ENTRYPOINT ["python", "-m", "src.cloud.run_pipeline_job"]
